# --- Dependencies (never vendored) ---
node_modules/
.venv/
venv/

# --- Build output & caches ---
dist/
build/
.cache/
.parcel-cache/
*.tsbuildinfo

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- Environment & secrets ---
.env
.env.*
!.env.example

# --- Models & large assets (fetched, not committed) ---
models/
*.gguf
*.onnx
*.safetensors

# --- Avatar & world packs ---
# Users drop their own packs here; the bundled examples are committed
# explicitly. Large model files are fetched rather than vendored.
avatars/*
!avatars/robot/
!avatars/ava/
!avatars/README.md
avatars/*/*.vrm
avatars/*/RETRIEVED.txt
worlds/*
!worlds/README.md
# The bundled worlds are committed, like `avatars/robot/`. Both test suites
# read `worlds/example/`, so a clone without it fails `make check` on arrival.
# A world pack is a single JSON file with no asset in it — there is nothing
# here that needs fetching.
!worlds/example/
!worlds/meadow/

# --- Demo media ---
# Raw captures stay out: they are large, and there will be several of them.
# The one compressed clip that ships lives in brand/ and is committed, so the
# repository is self-contained. GitHub will not render a player for it from a
# relative link — that needs the same file dragged into a README edit, which
# uploads a second copy to their CDN. The commit is for people who clone.
*.mp4
*.mov
*.webm
!brand/demo.mp4

# --- Simulation artifacts ---
snapshots/
recordings/
*.worldlog

# --- OS & editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Frontend build output ---
frontend/dist/
